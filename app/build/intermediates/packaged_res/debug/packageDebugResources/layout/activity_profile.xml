<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                   

    
                 
                            
                                                                        
           

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.profile.ProfileActivity" android:tag="layout/activity_profile_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <!-- App Bar with Material Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Mi Perfil"
                app:titleCentered="true"
                app:navigationIcon="@drawable/ic_back" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Main Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- User Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="?attr/materialCardViewStyle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Profile Icon and Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_marginEnd="16dp"
                                app:srcCompat="@drawable/ic_profile"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="Profile icon" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- Nombre del atleta (editable o texto fijo) -->
                                <EditText
                                    android:id="@+id/etAthleteName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:tag="binding_1"                
                                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                                                             
                                    android:inputType="textPersonName"
                                                                                      
                                    android:padding="4dp"/>

                                <!-- Descripción del atleta (editable o texto fijo) -->
                                <EditText
                                    android:id="@+id/etAthleteDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:tag="binding_2"                       
                                    android:hint="Añade una descripción"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                                                             
                                    android:inputType="textMultiLine"
                                    android:maxLines="3"
                                                                                      
                                    android:padding="4dp"/>
                            </LinearLayout>

                            <!-- Botón de editar/guardar -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditProfile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:tag="binding_3"                                      
                                                                      
                                app:iconTint="?attr/colorPrimary"/>
                        </LinearLayout>

                        <!-- Total Activities -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tag="binding_4"                             
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:layout_marginBottom="8dp"
                            tools:text="Total actividades: 24" />
                            
                        <!-- Since Date -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tag="binding_5"                        
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Activo desde: 12 de marzo, 2025" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Statistics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="?attr/materialCardViewStyle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estadísticas"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:layout_marginBottom="16dp" />

                        <!-- Total Distance -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                app:srcCompat="@drawable/ic_distance"
                                app:tint="?attr/colorPrimary" />
                                
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Distancia total"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="binding_6"                  
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                tools:text="124.5 km" />
                        </LinearLayout>
                        
                        <!-- Average Distance -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                app:srcCompat="@drawable/ic_distance"
                                app:tint="?attr/colorPrimary" />
                                
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Distancia media"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="binding_7"                    
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                tools:text="5.2 km" />
                        </LinearLayout>
                        
                        <!-- Maximum Distance -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                app:srcCompat="@drawable/ic_distance"
                                app:tint="?attr/colorPrimary" />
                                
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Distancia máxima"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="binding_8"                
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                tools:text="12.8 km" />
                        </LinearLayout>
                        
                        <!-- Total Duration -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                app:srcCompat="@drawable/ic_time"
                                app:tint="?attr/colorPrimary" />
                                
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tiempo total"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="binding_9"                  
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                tools:text="18h 30m" />
                        </LinearLayout>
                        
                        <!-- Average Pace -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                app:srcCompat="@drawable/ic_time"
                                app:tint="?attr/colorPrimary" />
                                
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ritmo medio"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="binding_10"               
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                tools:text="5:30 min/km" />
                        </LinearLayout>
                        
                        <!-- Total Elevation Gain -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                app:srcCompat="@drawable/ic_elevation_gain"
                                app:tint="?attr/colorPrimary" />
                                
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Desnivel acumulado"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:tag="binding_11"                      
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textStyle="bold"
                                tools:text="+1850 m" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
         