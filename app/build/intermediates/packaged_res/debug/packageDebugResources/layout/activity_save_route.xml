<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                   

    
                 
                            
                                                                            
                                                                       
                                                                     
           

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.saveroute.SaveRouteActivity" android:tag="layout/activity_save_route_0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">

        <!-- App Bar with Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Guardar Ruta"
                app:titleCentered="true"
                app:navigationIcon="@drawable/ic_back" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Main Content in a ScrollView for smaller screens -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Route Map Preview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="16dp"
                    style="?attr/materialCardViewStyle">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Static MapView to show route preview -->
                        <com.google.android.gms.maps.MapView
                            android:id="@+id/mapPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Overlay with stats summary -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#80000000"
                            android:padding="12dp"
                            android:orientation="horizontal">

                            <!-- Distance with icon -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="4dp"
                                    app:srcCompat="@drawable/ic_distance"
                                    app:tint="@android:color/white"
                                    android:contentDescription="Distance icon" />
                                    
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@android:color/white"
                                    android:textStyle="bold"
                                    android:tag="binding_1"                      
                                    tools:text="5.2 km" />
                            </LinearLayout>

                            <!-- Duration with icon -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="4dp"
                                    app:srcCompat="@drawable/ic_time"
                                    app:tint="@android:color/white"
                                    android:contentDescription="Duration icon" />
                                    
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@android:color/white"
                                    android:textStyle="bold"
                                    android:tag="binding_2"                      
                                    tools:text="45m 30s" />
                            </LinearLayout>

                            <!-- Elevation with icon -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="4dp"
                                    app:srcCompat="@drawable/ic_elevation"
                                    app:tint="@android:color/white"
                                    android:contentDescription="Elevation icon" />
                                    
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@android:color/white"
                                    android:textStyle="bold"
                                    android:tag="binding_3"                       
                                    tools:text="698m" />
                            </LinearLayout>

                            <!-- Elevation Gain with icon -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center">
                                
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="4dp"
                                    app:srcCompat="@drawable/ic_elevation_gain"
                                    app:tint="@android:color/white"
                                    android:contentDescription="Elevation gain icon" />
                                    
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@android:color/white"
                                    android:textStyle="bold"
                                    android:tag="binding_4"                           
                                    tools:text="+120m" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Route Form -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="?attr/materialCardViewStyle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Date (non-editable) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Fecha"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:tag="binding_5"                  
                                android:enabled="false"
                                tools:text="19 de abril, 2025" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Route Name (required) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Nombre de la ruta *"
                            app:errorEnabled="true"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRouteName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:tag="binding_6"               
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Route Description (required) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Descripción *"
                            app:errorEnabled="true" 
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRouteDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:tag="binding_7"                      
                                android:inputType="textMultiLine"
                                android:minLines="3"
                                android:gravity="top|start" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Añadir esto después del TextInputLayout de la descripción -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp">
                            
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Foto de la ruta (opcional)"
                                android:textAppearance="?attr/textAppearanceBodyMedium"/>
                            
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">
                                
                                <ImageView
                                    android:id="@+id/routeImagePreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="200dp"
                                    android:scaleType="centerCrop"
                                    android:tag="binding_8"                              
                                    android:contentDescription="Vista previa de la imagen" />
                                    
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSelectImage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Seleccionar foto"
                                    android:layout_gravity="center"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    app:icon="@drawable/ic_photo"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Actions Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <!-- Save Button (ahora a la izquierda) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Guardar"
                        android:tag="binding_9"                   
                        app:icon="@drawable/ic_save" />

                    <!-- Discard Button (ahora a la derecha) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDiscard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descartar"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
         