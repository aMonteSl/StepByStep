<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="black">#FF000000</color>
    <color name="moonstone">#39A2AE</color>
    <color name="oxford">#172745</color>
    <color name="route_color">#4285F4</color>
    <color name="turquoise">#55DBCB</color>
    <color name="turquoise_light">#82F4CE</color>
    <color name="white">#FFFFFFFF</color>
    <dimen name="map_padding">64dp</dimen>
    <string name="active_since">Activo desde: %1$s</string>
    <string name="add_new_route_description">Add new route</string>
    <string name="app_name">StepByStep</string>
    <string name="cancel">Cancelar</string>
