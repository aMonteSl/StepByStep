<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.StepByStep" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - Changed to turquoise -->
        <item name="colorPrimary">@color/turquoise</item>
        <item name="colorPrimaryVariant">@color/turquoise</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/turquoise</item>
        <item name="colorSecondaryVariant">@color/turquoise</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Additional colors -->
        <item name="colorSurface">#121212</item>  <!-- Dark gray for dark theme surface -->
        <item name="colorOnSurface">@color/white</item>
        <item name="colorError">@color/route_color</item>
        <item name="colorOnError">@color/black</item>
        <item name="colorTertiary">@color/moonstone</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorOnBackground">@color/white</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar color (Android 8.0+) -->
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        
        <!-- Customize Material components styles -->
        <item name="materialCardViewStyle">@style/Widget.StepByStep.CardView.Dark</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.StepByStep.FloatingActionButton</item>
        <item name="toolbarStyle">@style/Widget.StepByStep.Toolbar</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.StepByStep.BodyLarge.Dark</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.StepByStep.HeadlineSmall.Dark</item>
    </style>
    
    <!-- Custom Material component styles for Dark theme -->
    <style name="Widget.StepByStep.CardView.Dark" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/black</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>
    
    <!-- FloatingActionButton style remains the same as light theme to provide good visibility -->
    
    <!-- Custom text styles for dark theme -->
    <style name="TextAppearance.StepByStep.BodyLarge.Dark" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/white</item>
    </style>
    
    <style name="TextAppearance.StepByStep.HeadlineSmall.Dark" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/turquoise</item>
    </style>
</resources>