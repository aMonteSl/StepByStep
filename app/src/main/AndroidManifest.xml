<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.stepbystep">

    <!-- ************ PERMISOS DE UBICACIÓN ************ -->
    <!-- Permiso de ubicación precisa (requerido para el tracking GPS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" 
                     android:required="true" />
    
    <!-- Permiso de ubicación aproximada (implícito en versiones recientes de Android) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" 
                     android:required="false" />

    <!-- Permiso para tracking en segundo plano (Android 10+) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ************ PERMISOS DE SERVICIO ************ -->
    <!-- Permisos para servicios en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Opcional: Evitar que la app entre en modo doze -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- ************ PERMISOS DE ALMACENAMIENTO ************ -->
    <!-- Para acceso a imágenes en Android < 13 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Para acceso a imágenes en Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ************ CARACTERÍSTICAS DE HARDWARE ************ -->
    <!-- Sensor barómetro (opcional para elevación más precisa) -->
    <uses-feature android:name="android.hardware.sensor.barometer" 
                  android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepByStep"
        tools:targetApi="31">
        
        <!-- ************ API KEYS ************ -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />
        
        <!-- ************ ACTIVIDADES ************ -->
        <!-- Actividad principal (launcher) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad para crear nuevas rutas -->
        <activity 
            android:name=".ui.newroute.NewRouteActivity"
            android:exported="false" />
        
        <!-- Actividad para guardar rutas completadas -->
        <activity 
            android:name=".ui.saveroute.SaveRouteActivity"
            android:exported="false" />

        <!-- Actividad para ver detalles de rutas -->
        <activity 
            android:name=".ui.routedetail.RouteDetailActivity"
            android:exported="false" />

        <!-- Actividad de perfil de usuario -->
        <activity 
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <!-- Actividad para importar rutas GPX -->
        <activity
            android:name=".ui.importroute.ImportRouteActivity"
            android:exported="true">
            
            <!-- Intent filter para archivos GPX (scheme=file) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" 
                      android:mimeType="*/*"
                      android:pathPattern=".*\\.gpx" />
            </intent-filter>
            
            <!-- Intent filter para archivos GPX (scheme=content) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" 
                      android:mimeType="application/gpx+xml" />
            </intent-filter>
            
            <!-- Intent filter para archivos XML que podrían ser GPX -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" 
                      android:mimeType="application/xml" />
            </intent-filter>
            
            <!-- Intent filter para archivos con extensión .gpx sin tipo MIME específico -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content"
                      android:mimeType="*/*"
                      android:pathPattern=".*\\.gpx" />
            </intent-filter>
        </activity>

        <!-- ************ PROVEEDORES ************ -->
        <!-- Proveedor de archivos para compartir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ************ SERVICIOS ************ -->
        <!-- Servicio de tracking de ubicación -->
        <service
            android:name=".service.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>