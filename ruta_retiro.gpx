    <metadata>
        <name>Ruta por Madrid</name>
        <author>
            <name>Explorador</name>
        </author>
        <desc>Ruta de senderismo por el Parque del Retiro</desc>
    </metadata>

    <!-- Waypoints (Puntos de interés) -->
    <wpt lat="40.415363" lon="-3.682424">
        <name>Entrada al Parque</name>
        <desc>Punto de inicio de la ruta en la entrada principal.</desc>
    </wpt>
    <wpt lat="40.414450" lon="-3.681500">
        <name>Estanque Grande</name>
        <desc>Lugar emblemático del parque.</desc>
    </wpt>
    <wpt lat="40.413125" lon="-3.679832">
        <name>Palacio de Cristal</name>
        <desc>Hermoso edificio de cristal con vistas al lago.</desc>
    </wpt>

